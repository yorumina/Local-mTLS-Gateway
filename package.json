{
  "name": "opencode-mtls-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Loopback-only Chat, Models and TTS proxy with an outbound mTLS client certificate.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "control": "node --env-file=.env.local control-panel/server.mjs",
    "control:managed": "node --env-file=.env.local scripts/start-control-panel.mjs",
    "test:config": "node scripts/config-test.mjs",
    "test:control": "node scripts/control-panel-test.mjs",
    "check": "node scripts/policy-check.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  }
}
