# Copy to .env.local and keep the copy untracked. Do not put real secrets here.

# OpenCode sends this as Authorization: Bearer <value> to the loopback sidecar.
# Use a separate local-only value; do not reuse a production certificate password.
SIDECAR_API_KEY=

# The gateway origin. Keep this on HTTPS outside the isolated smoke test.
UPSTREAM_BASE_URL=https://llm.yorumina.com

# Optional. If present, this bearer token is used only for the upstream gateway.
# If empty, the authenticated OpenCode bearer token is forwarded upstream.
UPSTREAM_API_KEY=

# PEM client certificate and private key. Relative paths resolve from this folder.
MTLS_CERT_FILE=
MTLS_KEY_FILE=

# Optional private CA bundle. Leave empty when the gateway uses a publicly trusted CA.
MTLS_CA_FILE=

# Alternative to MTLS_CERT_FILE + MTLS_KEY_FILE for a PKCS#12/PFX client identity.
MTLS_PFX_FILE=
MTLS_PASSPHRASE=

HOST=127.0.0.1
PORT=8787
MAX_BODY_BYTES=16777216
UPSTREAM_TIMEOUT_MS=120000

# Never enable this in a real run. The smoke test sets it only for a loopback mock.
SIDECAR_TEST_MODE=false

