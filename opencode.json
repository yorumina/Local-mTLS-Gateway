{
  "$schema": "https://opencode.ai/config.json",
  "model": "gb10/gb10-private-llm",
  "provider": {
    "gb10": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GB10 Private LLM",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:SIDECAR_API_KEY}"
      },
      "models": {
        "gb10-private-llm": {
          "name": "GB10 Private LLM",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
